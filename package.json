{
  "name": "ruang-teduh",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:demo": "cross-env NODE_ENV=test PAYMENT_PROVIDER=simulated npm run dev",
    "db:up": "node scripts/db.mjs",
    "seed": "npm run seed -w apps/api",
    "admin:create": "npm run admin:create -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "build": "npm run build --workspaces",
    "test": "npm run test -w apps/api",
    "test:e2e": "playwright test",
    "reconcile": "npm run reconcile -w apps/api",
    "reconcile:demo": "cross-env NODE_ENV=test PAYMENT_PROVIDER=simulated npm run reconcile"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
